PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
# Set the service-role key only in Replit Secrets (never commit its value).
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
PUBLIC_API_URL=http://localhost:4000
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://fseg.pages.dev

# Storage
SUPABASE_BUCKET=fseg
# Optional previous bucket during migration; leave empty normally.
SUPABASE_FALLBACK_BUCKETS=
